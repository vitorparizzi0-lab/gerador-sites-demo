# Senha de acesso ao painel (quem tiver a senha pode criar demos e usar a IA)
DEMO_PASSWORD=

# Chave da API da Anthropic, usada pelo botão "Repaginar com IA"
ANTHROPIC_API_KEY=

# Banco dos links curtos (criadas pela Vercel ao conectar o Upstash for Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional: código de verificação do Google Search Console (só o valor do content da meta tag)
GOOGLE_SITE_VERIFICATION=
